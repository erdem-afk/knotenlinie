# /etc/kurul-ajan.env  (mode 0600, owner root; read by systemd for the kurul-ajan user)

# Site (SPEC section 8)
KURUL_BASE_URL=https://board.example.org
KURUL_AGENT_TOKEN=change-me

# Ledger checkout the agent answers from (any branch; the worker never checks out or pulls)
KURUL_REPO=/opt/kurul-ajan/ledger
# Public repository base for links in answer cards, and the branch/tag those links use
KURUL_REPO_URL=https://github.com/OWNER/REPO
KURUL_REPO_REF=main

# Model
KURUL_LLM=claude
KURUL_MODEL_FAST=haiku
KURUL_MODEL_MAIN=opus
KURUL_LLM_TIMEOUT=900

# Behaviour
KURUL_AUTORUN=0
KURUL_SUGGEST_THRESHOLD=0.85
KURUL_MENTION_THRESHOLD=0.6
# Personal names that must never appear in posts (comma-separated), e.g. the coordinator's name
KURUL_BLOCKED_NAMES=
# Extra internal names that must never appear in posts (comma-separated)
KURUL_BLOCKED_TERMS=

# Local state (cursor, handled events, notes, queue files, coordinator reports)
KURUL_STATE_DIR=/var/lib/kurul-ajan
